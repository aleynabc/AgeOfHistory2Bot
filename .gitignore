# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/
.env/
.venv/

# Environment / secrets
.env
.env.*
!.env.example

# Build directories
build/
dist/

# PyInstaller
*.spec.bak
*.manifest
*.toc

# Installer output
installer_output/

# Temporary installer files
*.tmp
*.temp

# Logs
*.log

# Runtime / temporary files
*.bak
*.swp
*.swo
*.tmp

# Windows thumbnail cache
Thumbs.db
ehthumbs.db

# Windows desktop configuration
Desktop.ini

# IDE - Visual Studio Code
.vscode/
*.code-workspace

# IDE - JetBrains
.idea/
*.iml

# Python IDE
*.pyc

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter Notebook
.ipynb_checkpoints/

# OS generated files
.DS_Store

# Archive files
*.zip
*.rar
*.7z

# Generated executables
*.exe

# Generated installers
*.msi

# Temporary build artifacts
*.pdb
*.bin

# Backup files
*~
*.orig

# Local configuration
config.local.*
settings.local.*

